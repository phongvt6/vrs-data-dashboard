# Sao chép file này thành ".env.local" rồi điền giá trị thật.
# .env.local KHÔNG được commit (đã nằm trong .gitignore).

# 1) Kết nối Supabase (Postgres)
#    Supabase → Project Settings → Database → Connection string → URI
#    Dùng chuỗi "Session pooler" hoặc "Direct connection" đều được.
DATABASE_URL=postgresql://postgres:MAT_KHAU@db.xxxx.supabase.co:5432/postgres

# 2) Mật khẩu chung để đăng nhập vào app (đặt tùy ý, đủ mạnh)
APP_PASSWORD=doi-mat-khau-nay

# 3) Chuỗi bí mật để ký phiên đăng nhập (random, càng dài càng tốt)
#    Tạo nhanh:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=doi-chuoi-bi-mat-nay

# 4) (tuỳ chọn, CHỈ DÙNG LOCAL) Tắt màn đăng nhập cho tiện lúc phát triển.
#    Đừng bao giờ khai báo trên Vercel/production — app sẽ mở cho bất kỳ ai có link.
# AUTH_DISABLED=1
